<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="azure-logical-web-app" name="Azure web app - logical example">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Azure web application - illustrative logical view" style="text;html=0;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="azure-scope" value="Azure subscription (organizational scope, not a network boundary)" style="swimlane;html=0;startSize=40;horizontal=1;rounded=0;fillColor=#F3F8FC;swimlaneFillColor=#FFFFFF;strokeColor=#0078D4;fontSize=14;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="1060" height="540" as="geometry" />
        </mxCell>
        <mxCell id="users" value="Application users" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api-management" value="Azure API Management" style="shape=image;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=14;image=img/lib/azure2/app_services/API_Management_Services.svg;" vertex="1" parent="azure-scope">
          <mxGeometry x="90" y="210" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="app-service" value="Azure App Service" style="shape=image;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=14;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="azure-scope">
          <mxGeometry x="390" y="210" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="Azure Storage" style="shape=image;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=14;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="azure-scope">
          <mxGeometry x="760" y="210" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="key-vault" value="Azure Key Vault" style="shape=image;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=14;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="azure-scope">
          <mxGeometry x="390" y="70" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="application-insights" value="Application Insights" style="shape=image;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=14;image=img/lib/azure2/management_governance/Application_Insights.svg;" vertex="1" parent="azure-scope">
          <mxGeometry x="390" y="390" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="users-to-api" value="HTTPS requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078D4;fontSize=12;" edge="1" parent="1" source="users" target="api-management">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="api-to-app" value="HTTPS backend calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078D4;fontSize=12;" edge="1" parent="azure-scope" source="api-management" target="app-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="app-to-storage" value="Read / write application data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078D4;fontSize=12;" edge="1" parent="azure-scope" source="app-service" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="app-to-key-vault" value="Get secrets (proposed managed identity)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;strokeColor=#666666;fontSize=12;" edge="1" parent="azure-scope" source="app-service" target="key-vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="app-to-insights" value="Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;strokeColor=#666666;fontSize=12;" edge="1" parent="azure-scope" source="app-service" target="application-insights">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid blue: request / data flow. Dashed gray: supporting secret access / telemetry.&#xa;Illustrative only: no VNet, private endpoints, zone redundancy, or production readiness implied." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="700" width="1060" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
